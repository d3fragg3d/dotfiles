{
  "layer": "bottom",
  "position": "top",
  "exclusive": true,
  "margin": "8 8 0 8",
  "height": 36,
  "spacing": 4,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock", "mpris"],
  "modules-right": ["custom/vpn", "custom/network", "wireplumber", "bluetooth", "battery", "custom/notification", "tray"],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "󰖟 Web",
      "2": "󰆍 Term",
      "3": "󰒋 Vim",
      "4": "󰎆 Media",
      "5": "󰾍 Misc"
    },
    "persistent-workspaces": {
      "*": 5
    },
    "on-click": "activate"
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "on-click": "~/.config/hypr/scripts/calendar.sh",
    "tooltip": false
  },

  "mpris": {
    "format": "󰐊 {title}",
    "format-paused": "󰏤 {title}",
    "max-length": 30,
    "tooltip": false
  },

  "custom/network": {
    "exec": "~/.config/hypr/scripts/network-status.sh",
    "interval": 2,
    "return-type": "json",
    "on-click": "~/.config/hypr/scripts/network-menu.sh",
    "tooltip": false
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "format-disabled": "󰂲",
    "tooltip": false,
    "on-click": "blueman-manager"
  },

  "wireplumber": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰝟 Muted",
    "tooltip": false
  },

  "battery": {
    "format": "󰁹 {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-warning": "󰁺 {capacity}%",
    "states": {
      "warning": 25,
      "critical": 15
    },
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/wlogout.sh 4"
  },

  "custom/vpn": {
    "exec": "~/.config/hypr/scripts/vpn-status.sh",
    "interval": 5,
    "return-type": "json",
    "on-click": "~/.config/hypr/scripts/vpn-menu.sh",
    "tooltip": false
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },


  "tray": {
    "spacing": 10
  }
}
